# API Keys - Replace with your actual keys

# Free tier news option 
TIINGO=your_tiingo_api_key_here

# LLM Provider (openai or chutes)
LLM_PROVIDER=openai

# OpenAI (if using OpenAI)
OPENAI_API_KEY=your_openai_api_key_here

# DeepSeek/Chutes (if using Chutes)
DEEPSEEK_API_KEY_1=your_deepseek_api_key_here
DEEPSEEK_API_KEY_2=your_deepseek_api_key_here
# Add more DEEPSEEK_API_KEY_N as needed for parallel processing

# Alpaca Trading (Paper Trading)
ALPACA_API_KEY=your_alpaca_paper_key_here
ALPACA_API_SECRET=your_alpaca_paper_secret_here
ALPACA_PAPER=true
ALPACA_ENABLED=true

# Alpaca Trading (Live - Optional, use with caution)
ALPACA_API_KEY_LIVE=your_alpaca_live_key_here
ALPACA_API_SECRET_LIVE=your_alpaca_live_secret_here

# Optional: FMP API Key (for additional data sources)
